  "keyFeatures": [
    "Book catalog management with ISBN uniqueness enforcement",
    "User registration and management with career tracking",
    "Loan system with availability checks and ACID-compliant transactions",
    "Automatic fine calculation for overdue books (after 7 days)",
    "Book reservation system with duplicate reservation prevention",
    "Donation tracking that links donated books to the catalog",
    "Reading ranking based on loan history",
    "Overdue loan alerts for loans approaching or past the due date",
    "CSV bulk import for books",
    "QR code generation for user identification",
    "Dark-themed CustomTkinter desktop GUI with sidebar navigation"
  ],
